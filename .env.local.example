# Local Development Environment Configuration
# Copy this to .env.local and fill in your values

# Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database Configuration
# For local development, you can:
# 1. Use Railway's PostgreSQL instance directly (recommended)
# 2. Set up a local PostgreSQL instance
DATABASE_URL="postgresql://user:password@host:port/database"

# API Keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
REPLICATE_API_TOKEN=r8_your-replicate-api-token

# DALL-E 3 Configuration (for illustration generation)
# Using OpenRouter for DALL-E 3 access
OPENROUTER_DALLE3_MODEL=openai/dall-e-3

# Security
SESSION_SECRET=dev-session-secret-change-in-production

# Development Settings
ENFORCE_AUTH_IN_DEV=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000  # Higher limit for dev

# Admin Configuration
ADMIN_EMAILS=admin@localhost

# Content Safety
CONTENT_MODERATION_ENABLED=false  # Disable for faster dev

# Logging
LOG_LEVEL=debug
ENABLE_METRICS=false

# Email (using Ethereal for testing)
EMAIL_SERVICE=ethereal
EMAIL_FROM=noreply@dreamweaver.local
APP_URL=http://localhost:3001

# HTTPS (disabled for local dev)
HTTPS_PORT=3443
FORCE_HTTPS=false

# Local file storage for development
LOCAL_STORAGE_PATH=./storage
STORAGE_TYPE=local  # 'local' or 'cloud'

# Client URL for CORS
CORS_ORIGIN=http://localhost:5173