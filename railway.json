{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm install -g tsx && cd server && npm install"
  },
  "deploy": {
    "startCommand": "cd server && tsx src/index.ts",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  },
  "environments": {
    "production": {
      "build": {
        "buildCommand": "npm install && npm install -g tsx && cd server && npm install"
      },
      "deploy": {
        "startCommand": "cd server && tsx src/index.ts"
      }
    }
  }
}